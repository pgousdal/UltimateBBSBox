# Managed by Ansible - ultimate-bbs-box (mystic_bbs role)
[Unit]
Description=Mystic BBS
After=network-online.target bbs-rs485-setup.service
Wants=network-online.target

[Service]
Type=simple
User={{ mystic_user }}
Group={{ mystic_group }}
WorkingDirectory={{ mystic_runtime_home | default(mystic_home) }}
ExecStart={{ mystic_runtime_home | default(mystic_home) }}/mis -bbs{% if mystic_enable_telnet %} -telnet {{ mystic_telnet_port }}{% endif %}
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ mystic_home }}/logs/mystic-stdout.log
StandardError=append:{{ mystic_home }}/logs/mystic-stderr.log

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ mystic_home }}
PrivateTmp=true

[Install]
WantedBy=multi-user.target
