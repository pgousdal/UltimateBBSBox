{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-bbs-box.invalid/schemas/integration-v1.schema.json",
  "title": "Ultimate BBS Box integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "target", "automation_level", "runtime", "installation", "qualification"],
  "properties": {
    "kind": {"const": "integration"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "target": {"type": "string", "minLength": 1},
    "integration_revision": {"type": "integer", "minimum": 1, "default": 1},
    "automation_level": {"enum": ["fully_automated", "assisted", "manual_install", "preservation_only"]},
    "runtime": {"enum": ["native", "fs_uae", "vice", "dos", "mame", "hatari", "qemu", "simh", "remote"]},
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["acquire", "verify", "unpack", "automated", "manual"]},
              "action": {"type": "string"},
              "instruction": {"type": "string"},
              "evidence_required": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {"type": "array", "items": {"enum": ["boots", "ready", "login", "menu", "message_post", "file_transfer", "door_launch", "network_exchange", "clean_shutdown"]}, "uniqueItems": true}
      }
    }
  }
}
