{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-bbs-box.invalid/schemas/integration-v1.schema.json",
  "title": "Ultimate BBS Box integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "target", "automation_level", "runtime", "installation", "qualification"],
  "properties": {
    "kind": {"const": "integration"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "target": {"type": "string", "minLength": 1},
    "integration_revision": {"type": "integer", "minimum": 1, "default": 1},
    "automation_level": {"enum": ["fully_automated", "assisted", "manual_install", "preservation_only"]},
    "runtime": {"enum": ["native", "fs_uae", "vice", "dos", "mame", "hatari", "qemu", "simh", "remote"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "role"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "role": {"enum": ["preservation_original", "install_source", "derived_install_media"]},
          "required": {"type": "boolean", "default": true}
        }
      },
      "uniqueItems": true
    },
    "runtime_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {"type": "string", "pattern": "^/", "minLength": 2},
        "argv": {"type": "array", "items": {"type": "string"}},
        "config_file": {"type": "string", "pattern": "^/", "minLength": 2},
        "working_directory": {"type": "string", "pattern": "^/", "minLength": 2},
        "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "additionalProperties": {"type": "string"}},
        "inherit_environment": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true},
        "pty": {"type": "boolean"},
        "stop_timeout_seconds": {"type": "number", "minimum": 0},
        "graceful_stop_command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "readiness": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"enum": ["immediate", "process_alive", "tcp_port", "file_exists", "command_exit_zero"]},
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "path": {"type": "string", "pattern": "^/"},
            "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "tcp_port"}}}, "then": {"required": ["host", "port"]}},
            {"if": {"properties": {"type": {"const": "file_exists"}}}, "then": {"required": ["path"]}},
            {"if": {"properties": {"type": {"const": "command_exit_zero"}}}, "then": {"required": ["command"]}}
          ]
        },
        "stream": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"enum": ["pty", "tcp", "stdio"]},
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "connect_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "tcp"}}}, "then": {"required": ["host", "port"]}}
          ]
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["acquire", "verify", "unpack", "automated", "manual"]},
              "action": {"type": "string"},
              "instruction": {"type": "string"},
              "evidence_required": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {"type": "array", "items": {"enum": ["boots", "ready", "login", "menu", "message_post", "file_transfer", "door_launch", "network_exchange", "clean_shutdown"]}, "uniqueItems": true}
      }
    }
  }
}
