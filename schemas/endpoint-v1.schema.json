{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultimate-bbs-box.invalid/schemas/endpoint-v1.schema.json",
  "title": "Ultimate BBS Box endpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "type"],
  "properties": {
    "kind": {"const": "endpoint"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "type": {"enum": ["local_process", "tcp", "ssh", "serial", "supervisor", "remote_supervisor"]},
    "host": {"type": "string"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "connect_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "protocol": {"enum": ["raw_tcp", "telnet", "ssh", "serial", "supervisor"]},
    "device": {"type": "string"},
    "baud": {"type": "integer", "minimum": 50},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "remote_service_id": {"type": "string"},
    "network_zone": {"enum": ["museum_isolated", "internal_services", "internet_restricted", "public"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "tcp"}}}, "then": {"required": ["host", "port", "protocol"]}},
    {"if": {"properties": {"type": {"const": "serial"}}}, "then": {"required": ["device", "baud"]}},
    {"if": {"properties": {"type": {"const": "local_process"}}}, "then": {"required": ["command"]}},
    {"if": {"properties": {"type": {"const": "ssh"}}}, "then": {"required": ["host"]}},
    {"if": {"properties": {"type": {"enum": ["supervisor", "remote_supervisor"]}}}, "then": {"required": ["host", "remote_service_id"]}}
  ]
}
